{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "enum",
  "version": "0.1.0",
  "identifier": "com.sa.enum",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "enum",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:expense.db"]
    },
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRjhGMjZBQzRDMzQ4NjgKUldSb1NNUEVhdkw0emx5WHBxeGVPUzRBL2J3OXFGSGFCMEdoWmZFMUVOU3pxMm5WeFdUcTNsK3gK",
      "endpoints": [
        "https://github.com/sankalpa-adhikari-sa/enum/releases/latest/download/latest.json"
      ]
    }
  }
}

